# Production template for noverainteriors.co (20i shared hosting).
# Copy to .env on the server, then fill in the blanks and run:
#   php artisan key:generate
#   php artisan migrate --force
#   php artisan storage:link
#   php artisan config:cache && php artisan route:cache && php artisan view:cache

APP_NAME="Novera Interiors"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://noverainteriors.co

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# 20i creates the database and user for you in the control panel.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave null unless the admin ever moves to a subdomain that must share the session.
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
# Media is served from the public disk, so `php artisan storage:link` must run
# on the server or every uploaded image 404s.
FILESYSTEM_DISK=public

# No daemon on shared hosting: run `php artisan queue:work --stop-when-empty`
# from a cron entry, or switch to sync if nothing is queued.
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# 20i mailboxes: smtp.stackmail.com, port 465 with SMTPS (or 587 with TLS).
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.stackmail.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@noverainteriors.co"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Records any untranslated string as it renders, so it shows up in the CMS.
# Leave off in production: it writes on render.
NOVERA_COLLECT_STRINGS=false
